{
    "name": "jeffersongoncalves/pest-plugin-mysql-compat",
    "description": "MySQL compatibility shims (UDFs) for running MySQL-flavored Pest/PHPUnit test suites against SQLite",
    "keywords": [
        "laravel",
        "pest",
        "pest-plugin",
        "mysql",
        "sqlite",
        "testing"
    ],
    "homepage": "https://github.com/jeffersongoncalves/pest-plugin-mysql-compat",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0",
        "laravel/framework": "^12.61.1|^13.12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\PestPluginMysqlCompat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\PestPluginMysqlCompat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\PestPluginMysqlCompat\\PestPluginMysqlCompatServiceProvider"
            ],
            "aliases": {
                "PestPluginMysqlCompat": "JeffersonGoncalves\\PestPluginMysqlCompat\\Facades\\PestPluginMysqlCompat"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
